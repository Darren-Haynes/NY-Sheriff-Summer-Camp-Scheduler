{
  "all": true,
  "sourceMap": true,
  "instrument": false,
  "report-dir": "./coverage/playwright",
  "include": [
    "src/renderer/**/*.{ts,tsx}"
  ],
  "exclude": [
    "node_modules/**",
    ".webpack/**",
    "test/e2e/**",
    "**/*.d.ts",
    "src/renderer/renderer.ts",
    "src/main/print-logs.ts"
  ],
  "reporter": [
    "html",
    "lcov",
    "text"
  ]
}
